# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=

# Required for scripts/share.sh (phone demo over the internet). At least 6 characters.
# Leave unset for local-only use.
ACCESS_CODE=

# Staff pages (/admin pack builder, /admin/insights). At least 8 characters, different from ACCESS_CODE.
# Leave unset to turn the staff pages off.
ADMIN_CODE=

# Glasses link via WhatsApp (optional). See "Glasses link (WhatsApp)" in README.md.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ALLOWED_NUMBERS=

# Optional tuning
# POINT_MODEL=claude-sonnet-5-5
# WEB_SEARCH=on
# ASKS_PER_SESSION=80
# ASKS_PER_IP=150
